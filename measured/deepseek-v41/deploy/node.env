# Paths for this node. Edit these before the first start; every other script reads them.
# NOTE (26 Nov 2026): the V4.1-Flash weights were deleted from cpt-gpu170; download them again (guide Step 2) before starting.
export V41_MODEL=/data/nvme3/lab/teachers/deepseek-v4.1-flash-1017   # model weights (476 GB)
export V41_CONTAINER=vllm                                            # enroot container made from vllm-0.32.0.sqsh
export V41_CACHE=/data/nvme3/shona-cpt/cache                         # compile caches (vllm, triton), reused across starts
export V41_LOGS=/data/nvme3/inference/deploy/logs
export V41_HOST=127.0.0.1                                            # 0.0.0.0 to serve other machines
export V41_PORT_A=8140 V41_PORT_B=8141
# enroot paths on this node (comment out if enroot uses its defaults)
. /data/nvme3/shona-cpt/enroot/env.sh
